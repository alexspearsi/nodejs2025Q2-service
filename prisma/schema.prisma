generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String @id @default(uuid())
  login     String @unique
  password  String
  version   Int    @default(1)
  createdAt BigInt
  updatedAt BigInt
  refreshToken String?
}

model Artist {
  id     String  @id @default(uuid())
  name   String
  grammy Boolean

  albums Album[] @relation("ArtistAlbum")
  tracks Track[] @relation("ArtistTrack")
}

model Album {
  id       String  @id @default(uuid())
  name     String
  year     Int
  artistId String?

  artist Artist? @relation("ArtistAlbum", fields: [artistId], references: [id], onDelete: SetNull)
  songs  Track[] @relation("AlbumTrack")
}

model Track {
  id       String  @id @default(uuid())
  name     String
  artistId String?
  albumId  String?
  duration Int

  artist Artist? @relation("ArtistTrack", fields: [artistId], references: [id], onDelete: SetNull)
  album  Album?  @relation("AlbumTrack", fields: [albumId], references: [id], onDelete: SetNull)
}

model Favorites {
  id      String   @id @default(uuid())
  artists String[]
  albums  String[]
  tracks  String[]
}
